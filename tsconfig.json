{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/app/animation-live/player/LiveMatchStatsPanel": ["./app/match-center/[id]/MatchDataPanel.tsx"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "app/api/admin/the-stats-backfill-events-safe/route.ts",
    "app/api/admin/the-stats-backfill-previous/route.ts",
    "app/api/admin/the-stats-import-match-events/route.ts",
    "app/api/admin/the-stats-live-catchup/route.ts",
    "app/api/admin/the-stats-live-debug/route.ts",
    "app/api/matches/live-card/route.ts",
    "components/match-page/ProfessionalMatchPage.tsx"
  ]
}
