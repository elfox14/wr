# Database
# Never commit a real production URL here. Put real values in Render/Supabase environment variables only.
DATABASE_URL="postgresql://username:password@hostname:5432/database"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="example-nextauth-secret"

# Render small instances
NODE_OPTIONS="--max-old-space-size=384"

# Admin / cron access
ADMIN_API_SECRET="example-admin-api-secret"
CRON_SECRET="example-cron-secret"
DATA_HUB_CRON_SECRET="example-data-hub-cron-secret"

# Internal live ingest
# External workers may POST verified match snapshots/events to /api/internal/live-ingest/match-snapshot.
# Public match pages never use this secret and never fetch external providers.
LIVE_INGEST_SECRET="example-live-ingest-secret"

# Automated Live Ingest Worker
# Run with: npm run worker:live-ingest
LIVE_INGEST_TARGET_ORIGIN="https://worldcup.mcprim.com"
LIVE_INGEST_LOOP="false"
LIVE_INGEST_POLL_SECONDS="180"
LIVE_INGEST_MATCH_LIMIT="4"
LIVE_INGEST_MAX_EXTERNAL_REQUESTS="4"
LIVE_INGEST_MIN_INTERVAL_SECONDS="180"
LIVE_INGEST_LOOKBACK_HOURS="3"
LIVE_INGEST_LOOKAHEAD_MINUTES="15"
LIVE_INGEST_FINISHED_HOURS="3"
LIVE_INGEST_SAVE_EMPTY="false"
LIVE_INGEST_INCLUDE_RAW="false"

# Source automation
# Used by /api/admin/auto-import-sports-reference, /api/admin/source-inbox-intake,
# and /api/admin/source-automation-status.
ADMIN_CRON_SECRET="example-admin-cron-secret"
SOURCE_INBOX_SECRET="example-source-inbox-secret"

# Public production origin used by internal cron orchestrators.
LIVE_SYNC_PUBLIC_ORIGIN="https://worldcup.mcprim.com"
NEXT_PUBLIC_SITE_URL="https://worldcup.mcprim.com"

# MC PRIME World Cup Data Hub
# Server-side bridge for https://mcprim.com/worldcup/api.php.
MC_PRIME_DATA_HUB_URL="https://mcprim.com/worldcup/api.php"
MC_PRIME_DATA_HUB_TOKEN=""
MC_PRIME_DATA_HUB_TIMEOUT_MS="15000"

# football-data.org
# Confirmation and backup source for fixtures, match status, and final score.
FOOTBALL_DATA_API_TOKEN=""
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"
FOOTBALL_DATA_COMPETITION="WC"
FOOTBALL_DATA_MIN_INTERVAL_MINUTES="5"

# TheStatsAPI
# Verification/enrichment only. Never expose this key to the browser.
# Odds, betting, bookmaker and handicap endpoints are blocked in code.
THE_STATS_API_ENABLED="false"
THE_STATS_API_VERIFY_ONLY="true"
THE_STATS_API_BLOCK_ODDS="true"
THE_STATS_API_KEY=""
THE_STATS_API_BASE_URL="https://api.thestatsapi.com"
THE_STATS_API_AUTH_HEADER="Authorization"
THE_STATS_API_AUTH_SCHEME="Bearer"
THE_STATS_API_TIMEOUT_MS="15000"
THE_STATS_API_WORLD_CUP_COMPETITION_ID="comp_6107"
THE_STATS_API_WORLD_CUP_SEASON_ID="sn_118868"

# Sports Reference / Stathead / FBref source automation
# manual_export mode reads CSV files from data/sports-reference.
SPORTS_REFERENCE_ENABLED="true"
SPORTS_REFERENCE_MODE="manual_export"
SPORTS_REFERENCE_EXPORTS_DIR="./data/sports-reference"

# Optional future API mode if an official API is available.
SPORTS_REFERENCE_API_BASE_URL=""
SPORTS_REFERENCE_API_KEY=""

# Market mode
NEXT_PUBLIC_MARKET_STATE="IPO"

# Football live provider fallback settings.
# Do not use browser rendering or visual scraping on the Render web service.
ISPORTS_API_KEY=""
ISPORTS_API_KEYS=""
ISPORTS_BASE_URL="http://api.isportsapi.com"
ISPORTS_FALLBACK_BASE_URL="http://api2.isportsapi.com"
ISPORTS_DAILY_SOFT_LIMIT="120"
ISPORTS_PROVIDER_CACHE_SECONDS=""
ISPORTS_LIVE_MIN_INTERVAL_SECONDS="180"

# Optional Google Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
