# Database
DATABASE_URL="postgresql://username:password@hostname:port/database"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Admin API access
# Use only as a request header: Authorization: Bearer <ADMIN_API_SECRET>
# or x-admin-secret: <ADMIN_API_SECRET>
ADMIN_API_SECRET="replace-with-a-strong-admin-secret"

# Market mode
# IPO keeps prices stable during launch; LIVE allows demand-based movement.
NEXT_PUBLIC_MARKET_STATE="IPO"

# Football providers
# API-Football / API-Sports
API_FOOTBALL_KEY=""
API_FOOTBALL_KEYS=""
API_FOOTBALL_BASE_URL="https://v3.football.api-sports.io"
API_FOOTBALL_DAILY_BUDGET="90"
API_FOOTBALL_DAILY_RESERVE="10"

# iSports API fallback / alternative provider
ISPORTS_API_KEY=""
ISPORTS_API_KEYS=""
ISPORTS_BASE_URL="http://api.isportsapi.com"

# Optional Google Auth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
