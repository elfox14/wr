# football-data.org
# Optional fallback/verification source for squads only when needed.
# Do not use it as an automatic replacement for curated official squad data.
FOOTBALL_DATA_API_TOKEN=""
FOOTBALL_DATA_API_KEY=""
FOOTBALL_DATA_BASE_URL="https://api.football-data.org/v4"

# TheStatsAPI
# Verification/enrichment only. Never expose this key to the browser.
# Odds, betting, bookmaker and handicap endpoints are blocked in code.
THE_STATS_API_ENABLED="false"
THE_STATS_API_VERIFY_ONLY="true"
THE_STATS_API_BLOCK_ODDS="true"
THE_STATS_API_KEY=""
THE_STATS_API_BASE_URL="https://api.thestatsapi.com"
THE_STATS_API_AUTH_HEADER="Authorization"
THE_STATS_API_AUTH_SCHEME="Bearer"
THE_STATS_API_TIMEOUT_MS="15000"

# Sports Reference / Stathead / FBref source automation
# manual_export mode reads CSV files from data/sports-reference.
SPORTS_REFERENCE_ENABLED="true"
SPORTS_REFERENCE_MODE="manual_export"
SPORTS_REFERENCE_EXPORTS_DIR="./data/sports-reference"

# Optional future API mode if an official API is available.
SPORTS_REFERENCE_API_BASE_URL=""
SPORTS_REFERENCE_API_KEY=""

# Market mode
NEXT_PUBLIC_MARKET_STATE="IPO"

