generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  username      String?        @unique
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?
  balance          Int            @default(10000)
  total_profit     Int            @default(0)
  role             String         @default("USER") // USER or ADMIN
  createdAt        DateTime       @default(now())

  // Ad Rewards
  adsWatchedToday     Int         @default(0)
  adsWatchedLifetime  Int         @default(0)
  rewardCreditsEarned Int         @default(0)

  // Rewards & Referrals
  lastDailyReward  DateTime?
  lastWeeklyReward DateTime?
  dailyStreak      Int            @default(0)
  watchList        String[]       @default([])
  referralCode     String?        @unique
  referredById     String?
  referredBy       User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]         @relation("Referrals")

  accounts         Account[]
  sessions         Session[]
  holdings         Holding[]
  transactions     Transaction[]
  notifications    Notification[]

  createdLeagues   League[]        @relation("LeagueCreator")
  leagueMembers    LeagueMember[]
  rewards          Reward[]

  // Phase 2 Relations
  captain          CaptainSelection?
  leagueMatchesA   LeagueMatch[]     @relation("MatchUserA")
  leagueMatchesB   LeagueMatch[]     @relation("MatchUserB")
  achievements     UserAchievement[]
}

model Reward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "DAILY", "WEEKLY", "REFERRAL", "WELCOME"
  amount    Int
  claimedAt DateTime @default(now())
}


model League {
  id          String   @id @default(cuid())
  name        String
  inviteCode  String   @unique
  creatorId   String
  creator     User     @relation("LeagueCreator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())

  members     LeagueMember[]
  matches     LeagueMatch[]
}

model LeagueMember {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([leagueId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   // INFO, SUCCESS, WARNING, ERROR
  read      Boolean  @default(false)
  timestamp DateTime @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Asset {
  id            String         @id // e.g. "team-ar", "player-messi"
  type          String         // "TEAM" or "PLAYER"
  name          String
  code          String         // e.g. "AR", "LM10"
  image         String         // flag or player face (emoji or url)
  current_price Int
  high_price    Int
  low_price     Int
  market_cap    String
  volume        String
  change        Float

  // Group for World Cup (e.g. "A", "B", etc. - only for teams)
  group         String?

  // --- NEW SCORING & FILTERING FIELDS ---
  continent     String? // e.g., "South America", "Europe", "Africa"
  fifaRank      Int?    // e.g. 1 (for Argentina)
  position      String? // e.g. "GK", "DEF", "MID", "FWD" (for players)
  playerTier    Float?  // 1.0 (Star), 0.8 (Starter), 0.5 (Sub), etc.
  roleImportance Float? // 1.0 to 0.1
  score         Float?  // The dynamic or static score 0-100
  isAvailable   Boolean @default(true) // For World Cup 26 roster
  
  // --- ADVANCED TRADING FIELDS ---
  age               Int?
  club              String?
  coach             String?
  participations    Int?
  injuries          Int?    @default(0) // 0 means perfect health
  harmony           Float?  @default(1.0)
  riskIndex         Float?  @default(0.5) // 0.0 to 1.0
  ownersCount       Int     @default(0)
  globalMarketValue Float?  // in millions, e.g. 180 for Mbappe
  
  // --- ECONOMY REFACTOR FIELDS ---
  popularity        Float?  @default(50) // Global fan popularity (0-100)
  fundamental       Float?  @default(50) // Football quality (0-100)
  worldCupLegacy    Float?  @default(50) // Historical legacy (0-100)
  marketDemand      Float?  @default(50) // Calculated from trading activity
  momentum          Float?  @default(50) // Short term performance
  volatilityScore   Float?  @default(10) // e.g. Yamal=70, Messi=15
  fairValue         Float?  @default(0)  // Calculated from 5 pillars
  marketPrice       Float?  @default(0)  // Affected by real supply/demand
  // -------------------------------------

  // Relation: A player belongs to a team
  teamId        String?
  team          Asset?         @relation("TeamPlayers", fields: [teamId], references: [id])
  players       Asset[]        @relation("TeamPlayers")

  // Relation: Matches
  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")

  holdings      Holding[]
  transactions  Transaction[]
  marketNews    MarketNews[]
  priceHistory  PriceHistory[]
  captains      CaptainSelection[]
}

model Match {
  id          String   @id @default(cuid())
  externalId  String?  @unique // Matches from openfootball
  homeTeamId  String
  homeTeam    Asset    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId  String
  awayTeam    Asset    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  
  matchDate   DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PLAY, FINISHED
  
  homeScore   Int      @default(0)
  awayScore   Int      @default(0)
  
  groupPhase  String?  // e.g. "Group A"
  stage       String   @default("group") // group, round_of_16, quarter_final, semi_final, final
}

model PriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price     Int
  timestamp DateTime @default(now())
}

model Holding {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  asset          Asset    @relation(fields: [assetId], references: [id])
  assetId        String
  positionType   String   @default("LONG") // "LONG" or "SHORT"
  quantity       Int
  avg_buy_price  Float

  @@unique([userId, assetId, positionType])
}

model Transaction {
  id             String   @id @default(cuid())
  user           User     @relation(fields: [userId], references: [id])
  userId         String
  asset          Asset    @relation(fields: [assetId], references: [id])
  assetId        String
  type           String   // "BUY" or "SELL"
  quantity       Int
  price_at_time  Int
  timestamp      DateTime @default(now())
}

model MarketNews {
  id              String   @id @default(cuid())
  asset           Asset    @relation(fields: [assetId], references: [id])
  assetId         String
  eventType       String   // price_spike, price_drop, win, loss, qualification, elimination, upset_win, strong_rally, sharp_selloff
  severity        String   @default("normal") // low, normal, high
  localeGroupKey  String?  // For deduplication: "{assetId}:{eventType}"
  priceBefore     Float?
  priceAfter      Float?
  changePercent   Float    @default(0)
  // Static rendered text (backward compatible)
  titleAr         String
  bodyAr          String
  titleEn         String
  bodyEn          String
  // Template-based i18n (new)
  titleKey        String?  // e.g. "marketNews.price_spike.title"
  bodyKey         String?  // e.g. "marketNews.price_spike.body"
  titleParams     Json?    // e.g. {"team": "Argentina", "change": "3.50"}
  bodyParams      Json?    // e.g. {"team": "Argentina", "before": "5000", "after": "5175", "reason": "..."}
  context         Json?    // Extra context: {"stage": "group", "opponent": "France"}
  publishedAt     DateTime @default(now())

  @@index([assetId, publishedAt])
  @@index([eventType, publishedAt])
}

// --- PHASE 2 MODELS ---

model CaptainSelection {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model LeagueMatch {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userAId    String
  userBId    String
  userA      User     @relation("MatchUserA", fields: [userAId], references: [id])
  userB      User     @relation("MatchUserB", fields: [userBId], references: [id])
  winnerId   String?  // Null if draw
  matchweek  Int
  createdAt  DateTime @default(now())
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String   // E.g., 'DIAMOND_HANDS', 'WOLF_OF_WALL_STREET'
  earnedAt    DateTime @default(now())

  @@unique([userId, badgeId])
}
